/* =====================================================================
 * WIZARD PROFESIONAL + FIELD MINIMALIS (permintaan user 2026-09-17)
 * ---------------------------------------------------------------------
 * Berlaku OTOMATIS ke SEMUA form wizard di aplikasi (Create NAS, Outlet,
 * Reseller, Biller, dll) -- tidak perlu diubah satu-satu per form,
 * karena semuanya memakai komponen Wizard bawaan Filament yang sama.
 *
 * Nama class di bawah ini BUKAN tebakan -- disalin dari sumber resmi
 * Filament v4: vendor/filament/schemas/resources/css/components/
 * wizard.css & vendor/filament/support/resources/css/components/input/
 * wrapper.css. Kalau suatu saat Filament di-upgrade dan tampilan ini
 * "hilang", cek dulu apakah nama class di 2 file itu berubah.
 * ===================================================================== */

/* ---------- 1. Kerangka wizard ---------- */
.fi-sc-wizard.fi-contained {
    border-radius: 1rem;
    overflow: hidden;
}

/* Header (baris langkah 1-2-3) -- dikasih latar beda tipis supaya
   terbaca sebagai "panel navigasi", bukan menyatu dengan isi form. */
.fi-sc-wizard .fi-sc-wizard-header {
    background: #fafafa;
    padding: 0.35rem 0.5rem;
    gap: 0.25rem;
}
.dark .fi-sc-wizard .fi-sc-wizard-header {
    background: rgba(255, 255, 255, 0.02);
}

/* Tiap langkah jadi "kartu" sendiri, biar batas antar langkah jelas. */
.fi-sc-wizard .fi-sc-wizard-header-step {
    border-radius: 0.75rem;
    transition: background 0.15s ease;
}
.fi-sc-wizard .fi-sc-wizard-header-step.fi-active {
    background: rgba(234, 88, 12, 0.06);
}
.dark .fi-sc-wizard .fi-sc-wizard-header-step.fi-active {
    background: rgba(234, 88, 12, 0.12);
}
.fi-sc-wizard .fi-sc-wizard-header-step-btn {
    gap: 0.85rem;
    padding: 0.85rem 1.1rem;
}

/* Lingkaran nomor langkah -- lebih besar & tegas. */
.fi-sc-wizard .fi-sc-wizard-header-step-icon-ctn {
    width: 2.5rem;
    height: 2.5rem;
    border-width: 2px;
    box-shadow: none;
    transition: all 0.15s ease;
}
/* Langkah AKTIF: lingkaran terisi penuh oranye, nomornya putih --
   ini pembeda utama dari tampilan standar Filament (yang cuma
   mewarnai garis tepi & angkanya saja, jadi kurang menonjol). */
.fi-sc-wizard .fi-sc-wizard-header-step.fi-active:not(.fi-completed) .fi-sc-wizard-header-step-icon-ctn {
    background: #ea580c;
    border-color: #ea580c;
    box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.15);
}
.fi-sc-wizard .fi-sc-wizard-header-step.fi-active:not(.fi-completed) .fi-sc-wizard-header-step-number,
.fi-sc-wizard .fi-sc-wizard-header-step.fi-active:not(.fi-completed) .fi-sc-wizard-header-step-icon-ctn .fi-icon {
    color: #ffffff !important;
}
/* Langkah yang SUDAH dilewati: lingkaran oranye solid + centang putih
   (bawaan Filament sudah begitu, di sini cuma disamakan ukurannya). */
.fi-sc-wizard .fi-sc-wizard-header-step.fi-completed .fi-sc-wizard-header-step-icon-ctn {
    background: #ea580c;
    border-color: #ea580c;
}
/* Langkah yang BELUM dijalani: abu lembut, tidak mencolok. */
.fi-sc-wizard .fi-sc-wizard-header-step:not(.fi-active):not(.fi-completed) .fi-sc-wizard-header-step-icon-ctn {
    background: #f4f4f5;
    border-color: #e4e4e7;
}
.dark .fi-sc-wizard .fi-sc-wizard-header-step:not(.fi-active):not(.fi-completed) .fi-sc-wizard-header-step-icon-ctn {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
}

/* Judul & keterangan langkah. */
.fi-sc-wizard .fi-sc-wizard-header-step-label {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.fi-sc-wizard .fi-sc-wizard-header-step-description {
    font-size: 0.75rem;
    margin-top: 0.1rem;
}

/* Panah pemisah bawaan diganti garis tipis -- lebih bersih. */
.fi-sc-wizard .fi-sc-wizard-header-step-separator {
    display: none !important;
}

/* Isi tiap langkah dikasih napas lebih lega. */
.fi-sc-wizard.fi-contained .fi-sc-wizard-step.fi-active {
    padding: 1.75rem 1.5rem;
}

/* ---------- 2. Field minimalis (khusus di dalam wizard) ----------
 * Sengaja DIBATASI ke dalam .fi-sc-wizard saja -- supaya tampilan
 * form/tabel lain di aplikasi TIDAK ikut berubah (menghindari efek
 * samping tak terduga di halaman-halaman yang sudah mapan). */
.fi-sc-wizard .fi-input-wrp {
    border-radius: 0.65rem;
    background: #fcfcfd;
    box-shadow: none;
    --tw-ring-color: #e4e4e7;
    --tw-ring-offset-width: 0px;
    transition: all 0.15s ease;
}
.dark .fi-sc-wizard .fi-input-wrp {
    background: rgba(255, 255, 255, 0.03);
    --tw-ring-color: rgba(255, 255, 255, 0.1);
}
/* Fokus: cincin oranye lembut, bukan garis tebal standar. */
.fi-sc-wizard .fi-input-wrp:not(.fi-disabled):focus-within {
    background: #ffffff;
    --tw-ring-color: #ea580c !important;
    box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.1);
}
.dark .fi-sc-wizard .fi-input-wrp:not(.fi-disabled):focus-within {
    background: rgba(255, 255, 255, 0.05);
}
/* Ruang ketik lebih lapang. */
.fi-sc-wizard .fi-input,
.fi-sc-wizard .fi-select-input {
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
    font-size: 0.875rem;
}
/* Label field: kecil, tegas, sedikit renggang -- gaya "form modern". */
.fi-sc-wizard .fi-fo-field-lbl,
.fi-sc-wizard .fi-fo-field-lbl-ctn label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
}
/* Teks bantuan di bawah field dibuat lebih kalem. */
.fi-sc-wizard .fi-fo-field-wrp-helper-text {
    font-size: 0.75rem;
    line-height: 1.5;
    opacity: 0.85;
}

/* ---------- 3. Tombol navigasi bawah ---------- */
.fi-sc-wizard .fi-sc-wizard-footer {
    padding-top: 0.25rem;
}
/* =====================================================================
 * MODAL FORM MINIMALIS & ELEGAN (permintaan user 2026-09-17)
 * ---------------------------------------------------------------------
 * Berlaku OTOMATIS ke SEMUA modal form di aplikasi (Create/Edit
 * Bandwidth, NAS, Outlet, Reseller, Biller, dll) -- semuanya memakai
 * komponen Modal & Section bawaan Filament yang sama, jadi cukup
 * sekali atur di sini.
 *
 * Nama class di bawah ini disalin dari sumber resmi Filament v4:
 * vendor/filament/support/resources/css/components/modal.css &
 * .../section.css -- BUKAN tebakan (lihat catatan di file wizard
 * kalau butuh alasan kenapa ini penting).
 * ===================================================================== */

/* ---------- 1. Jendela modal ---------- */
.fi-modal-window {
    border-radius: 1.15rem !important;
    box-shadow: 0 20px 45px -12px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.04);
    /* Garis aksen tipis oranye di tepi atas -- pembeda halus dari
       modal standar Filament yang polos putih. */
    border-top: 3px solid #ea580c;
}
.dark .fi-modal-window {
    box-shadow: 0 20px 45px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.06);
}

/* ---------- 2. Header (judul + tombol tutup) ---------- */
.fi-modal-header {
    padding: 1.5rem 1.5rem 1.15rem !important;
    align-items: flex-start !important;
}
.fi-modal-heading {
    font-size: 1.1rem !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em;
}
.fi-modal-description {
    font-size: 0.8125rem !important;
    color: #ea580c;
    font-weight: 500;
    margin-top: 0.15rem !important;
}
.dark .fi-modal-description {
    color: #fb923c;
}
/* Tombol tutup (X) -- dibuat bulat lembut, bukan kotak polos. */
.fi-modal-close-btn {
    border-radius: 9999px !important;
    background: #f4f4f5;
    transition: background 0.15s ease;
}
.fi-modal-close-btn:hover {
    background: #ea580c !important;
}
.fi-modal-close-btn:hover .fi-icon {
    color: #ffffff !important;
}
.dark .fi-modal-close-btn {
    background: rgba(255, 255, 255, 0.06);
}

/* Garis pemisah tipis antara header & isi -- ganti dari kesan
   "menyatu" jadi terstruktur rapi. */
.fi-modal-window > .fi-modal-header {
    border-bottom: 1px solid #f4f4f5;
}
.dark .fi-modal-window > .fi-modal-header {
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

/* ---------- 3. Isi form: hilangkan kotak-dalam-kotak ---------- */
.fi-modal-content {
    padding-top: 1.35rem !important;
    padding-bottom: 1.1rem !important;
}
/* Section PALING LUAR (bungkus semua field) di dalam modal -- kalau
   tidak punya heading sendiri, ini cuma dipakai sebagai wadah, JADI
   kotak/bayangan/ring bawaannya dihilangkan supaya field-nya terasa
   langsung menyatu dengan modal (tidak dobel kotak seperti gambar
   referensi lama). Section BER-HEADING (mis. "Pengaturan Kecepatan")
   TETAP dapat gaya kotak, diatur terpisah di bawah. */
.fi-modal-content .fi-section:not(.fi-section-has-header) {
    box-shadow: none !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
}
.fi-modal-content .fi-section:not(.fi-section-has-header) > .fi-section-content-ctn > .fi-section-content {
