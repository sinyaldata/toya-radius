/* Main modal
 *
 * PERBAIKAN (akar masalah "form Biller tidak bisa discroll", setelah
 * 2 percobaan sebelumnya -- slideOver() & padding-bottom repeater --
 * ternyata belum menyentuh akarnya):
 * Sebelumnya HANYA .fi-modal-window sendiri yang overflow-y:auto,
 * jadi header + konten + footer dianggap SATU blok scroll yang
 * tingginya dihitung dari total kontennya, lalu dibatasi max-height.
 * Ini "kelihatan" jalan untuk form pendek, tapi begitu isi form jadi
 * sangat tinggi (repeater dengan banyak baris di form Biller),
 * baris/field paling bawah betul-betul terpotong dan browser gagal
 * membuka area scroll yang cukup untuk itu -- makanya cuma kelihatan
 * lengkap kalau browser di-zoom out (viewport CSS jadi "lebih besar"
 * relatif terhadap konten yang ukurannya tetap dalam px/rem).
 *
 * Perbaikan: .fi-modal-window dijadikan flex COLUMN dengan tinggi
 * dibatasi (max-height), dan TIDAK lagi ikut scroll sendiri --
 * overflow:hidden di level window sekarang AMAN (lihat catatan di
 * bawah). Header & footer diberi flex-shrink:0 (lihat rule
 * masing-masing) supaya selalu utuh & tetap di tempat, dan HANYA
 * .fi-modal-content yang jadi area scroll (flex:1 + min-height:0 +
 * overflow-y:auto). min-height:0 ini kuncinya: tanpa itu, flex child
 * secara default menolak menyusut di bawah tinggi kontennya sendiri
 * (min-height:auto bawaan flexbox) -- jadi overflow-y:auto di
 * .fi-modal-content tidak pernah benar-benar aktif, dan sisanya
 * kepotong oleh box induknya. Ini akar masalahnya. */
.fi-modal-window {
    width: min(700px, calc(100vw - 2rem)) !important;
    max-width: 700px !important;
    max-height: calc(100vh - 2rem) !important;
    border: 1px solid rgba(228,228,231,.95) !important;
    border-radius: 1.15rem !important;
    background: #fff !important;
    box-shadow:
        0 25px 70px rgba(15,23,42,.18),
        0 8px 25px rgba(15,23,42,.08) !important;
    display: flex !important;
    flex-direction: column !important;
    /* overflow:hidden AMAN di sini sekarang -- window sendiri TIDAK
     * lagi jadi area scroll, itu tugas .fi-modal-content di bawah.
     * overflow-x:clip tetap dipakai supaya sudut membulat tetap rapi. */
    overflow-x: clip !important;
    overflow-y: hidden !important;
}

/* Modal header -- flex-shrink:0 supaya tidak ikut menyusut/hilang,
 * karena sekarang cuma .fi-modal-content yang boleh scroll. */
.fi-modal-header {
    min-height: 5.2rem !important;
    padding: 1.15rem 1.35rem !important;
    background: #fff !important;
    border-bottom: 1px solid #f0f0f1 !important;
    display: flex !important;
    align-items: center !important;
    flex-shrink: 0 !important;
}

/* Heading */
