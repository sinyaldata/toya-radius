/* ============================================================
 * TOYA RADIUS UI SYSTEM   Design System Capstone
 * ============================================================
 * Ditaruh SENGAJA di baris paling akhir file supaya jadi acuan
 * FINAL yang menang lawan aturan-aturan sebelumnya di file ini
 * (yang terkumpul dari banyak iterasi terpisah selama sesi ini).
 * Tujuannya: satu standar konsisten untuk Button, Input/Select,
 * Badge, Table, Modal, Dropdown, Sidebar active-state, Notification
 *   berlaku ke SELURUH halaman karena ini CSS global, bukan per-
 * resource. TIDAK ADA perubahan logic/backend di sini   murni
 * presentation layer, pakai token warna & radius yang sudah
 * didefinisikan di :root paling atas file ini.
 * ============================================================ */

/* ---- 1. BUTTON SYSTEM ---- */
.fi-btn {
    border-radius: 0.55rem !important;
    font-weight: 600 !important;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease !important;
}

.fi-btn.fi-color-primary {
    background-color: var(--toya-orange) !important;
    color: #ffffff !important;
}

.fi-btn.fi-color-primary:hover {
    background-color: var(--toya-orange-dark) !important;
}

.fi-btn.fi-color-gray,
.fi-btn:not([class*="fi-color-"]) {
    background-color: var(--toya-card) !important;
    border: 1px solid var(--toya-border) !important;
    color: var(--toya-text-secondary) !important;
}

.fi-btn.fi-color-success { background-color: var(--toya-success) !important; }
.fi-btn.fi-color-danger { background-color: var(--toya-danger) !important; }
.fi-btn.fi-color-info { background-color: var(--toya-info) !important; }
.fi-btn.fi-color-warning { background-color: var(--toya-warning) !important; }

.fi-icon-btn {
    width: 2rem !important;
    height: 2rem !important;
    border-radius: 0.5rem !important;
    transition: background-color 150ms ease !important;
}

/* ---- 2. INPUT / SELECT SYSTEM ---- */
.fi-input,
.fi-select-input {
    height: 2.5rem !important;
    min-height: 2.5rem !important;
    border-radius: 0.55rem !important;
    border-color: var(--toya-border) !important;
    font-size: 0.8125rem !important;
}

/* (dihapus � sama seperti catatan di atas) */

.fi-fo-field-wrp-label {
    font-size: 0.8125rem !important;
    font-weight: 600 !important;
    color: var(--toya-text-primary) !important;
}

/* ---- 3. BADGE / STATUS SYSTEM ---- */
.fi-badge {
    font-size: 0.6875rem !important;
    font-weight: 600 !important;
    border-radius: 9999px !important;
    padding-inline: 0.55rem !important;
}

.fi-badge.fi-color-success { background: var(--toya-success-soft) !important; color: var(--toya-success) !important; }
.fi-badge.fi-color-warning { background: var(--toya-warning-soft) !important; color: var(--toya-warning) !important; }
.fi-badge.fi-color-danger { background: var(--toya-danger-soft) !important; color: var(--toya-danger) !important; }
.fi-badge.fi-color-info { background: var(--toya-info-soft) !important; color: var(--toya-info) !important; }
.fi-badge.fi-color-gray { background: #f4f4f5 !important; color: var(--toya-text-muted) !important; }

/* ---- 4. TABLE SYSTEM ---- */
.fi-ta-ctn {
    background: var(--toya-card) !important;
    border: 1px solid var(--toya-border) !important;
    border-radius: var(--toya-radius) !important;
}

.fi-ta-header-cell {
    background: var(--toya-bg) !important;
    font-weight: 600 !important;
    font-size: 0.75rem !important;
    color: var(--toya-text-secondary) !important;
}

.fi-ta-cell {
    font-size: 0.8125rem !important;
    color: var(--toya-text-primary) !important;
}

.fi-ta-row:hover {
    background-color: rgba(249, 115, 22, 0.035) !important;
}

/* ---- 5. MODAL SYSTEM ---- */
.fi-modal-window {
    border-radius: 1rem !important;
    max-height: 90vh !important;
}

.fi-modal-close-overlay {
    background-color: rgba(15, 23, 42, 0.45) !important;
}

/* ---- 6. DROPDOWN SYSTEM ---- */
.fi-dropdown-panel {
    background: var(--toya-card) !important;
    border: 1px solid var(--toya-border) !important;
    border-radius: 0.65rem !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;
}

.fi-dropdown-list-item:hover {
    background-color: var(--toya-orange-soft) !important;
}

/* ---- 7. SIDEBAR ACTIVE STATE ---- */
.fi-sidebar-item-active .fi-sidebar-item-btn {
    background: var(--toya-orange-soft) !important;
    color: var(--toya-orange-dark) !important;
}

/* ---- 8. NOTIFICATION SYSTEM ---- */
.fi-no-notification.fi-color-success { border-inline-start: 3px solid var(--toya-success) !important; }
.fi-no-notification.fi-color-warning { border-inline-start: 3px solid var(--toya-warning) !important; }
.fi-no-notification.fi-color-danger { border-inline-start: 3px solid var(--toya-danger) !important; }
.fi-no-notification.fi-color-info { border-inline-start: 3px solid var(--toya-info) !important; }

/* ---- 9. PAGINATION ---- */
.fi-pagination-item[aria-current="page"] {
    background: var(--toya-orange) !important;
    color: #ffffff !important;
}

/* ============================================================
 * TOYA RADIUS UI SYSTEM   Lanjutan #2: Empty State & Dark Mode
 * ============================================================ */

/* ---- 10. EMPTY STATE ---- */
.fi-empty-state {
    padding-block: 3rem !important;
}

.fi-empty-state-icon-bg {
    background: var(--toya-orange-soft) !important;
    width: 3.5rem !important;
    height: 3.5rem !important;
    border-radius: 9999px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-inline: auto !important;
}

.fi-empty-state-icon-bg svg {
    color: var(--toya-orange) !important;
    width: 1.75rem !important;
    height: 1.75rem !important;
}

.fi-empty-state-heading {
    font-size: 0.9375rem !important;
    font-weight: 700 !important;
    color: var(--toya-text-primary) !important;
    margin-block-start: 1rem !important;
}

.fi-empty-state-description {
    font-size: 0.8125rem !important;
    color: var(--toya-text-muted) !important;
    margin-block-start: 0.25rem !important;
}

.fi-empty-state-footer {
    margin-block-start: 1.25rem !important;
}

/* ---- 11. DARK MODE   pasangan token baru dari lapisan sebelumnya ---- */
.dark {
    --toya-text-primary: #fafafa;
    --toya-text-secondary: #d4d4d8;
    --toya-text-muted: #a1a1aa;
    --toya-border: rgba(255, 255, 255, 0.08);
    --toya-bg: #18181b;
    --toya-card: #27272a;

    --toya-success-soft: rgba(22, 163, 74, 0.12);
    --toya-warning-soft: rgba(217, 119, 6, 0.12);
    --toya-danger-soft: rgba(220, 38, 38, 0.12);
    --toya-info-soft: rgba(37, 99, 235, 0.12);
}

.dark .fi-empty-state-icon-bg {
    background: rgba(249, 115, 22, 0.12) !important;
}

/* ============================================================
 * TOYA RADIUS UI SYSTEM   Lanjutan #3: Toggle, Radio, Pagination
 * ============================================================ */

/* ---- 12. TOGGLE (SWITCH) ---- */
.fi-toggle {
    border-radius: 9999px !important;
    transition: background-color 150ms ease !important;
}

.fi-toggle-off {
    background-color: #e4e4e7 !important;
}

.dark .fi-toggle-off {
    background-color: rgba(255, 255, 255, 0.12) !important;
}

/* ---- 13. RADIO ---- */
.fi-fo-radio-label {
    font-size: 0.8125rem !important;
    color: var(--toya-text-primary) !important;
}

.fi-fo-radio-label-description {
    font-size: 0.75rem !important;
    color: var(--toya-text-muted) !important;
}

.fi-fo-radio input[type="radio"] {
    accent-color: var(--toya-orange) !important;
    width: 1.05rem !important;
    height: 1.05rem !important;
}

/* ---- 14. PAGINATION (penutup) ---- */
.fi-pagination-overview {
    font-size: 0.75rem !important;
    color: var(--toya-text-muted) !important;
}

.fi-pagination-items-per-page-select .fi-select-input {
    height: 2.1rem !important;
    min-height: 2.1rem !important;
}

/* ============================================================
 * TOYA RADIUS UI SYSTEM   Lanjutan #4: Tabel User Hotspot (spec detail)
 * ============================================================ */

/* Search box: lebar terbatas 280-320px sesuai spesifikasi (bukan
 * melebar penuh), supaya proporsional dengan toolbar lainnya. */
.fi-ta-search-field {
    max-width: 300px !important;
    width: 100% !important;
}

.fi-ta-search-field .fi-input,
.fi-ta-search-field input {
    height: 2.4rem !important;
    min-height: 2.4rem !important;
}

/* Bar aksi massal (muncul saat baris dicentang)   dibuat elegan,
 * menempel rapi di atas tabel, bukan kotak mencolok. */
.fi-ta-selection-indicator {
    background: var(--toya-orange-soft) !important;
    border: 1px solid #fed7aa !important;
    border-radius: 0.6rem !important;
