/* ============================================================
 * REDESAIN PROFESIONAL v4 -- TOMBOL, TABEL, FORM
 * ============================================================
 * Section final ini adalah satu-satunya sumber kebenaran untuk
 * tampilan tombol, tabel, dan form ke depannya. Ditaruh paling
 * akhir file supaya override semua rule sebelumnya (sama seperti
 * pola "PENUTUP FINAL" yang sudah dipakai di file ini).
 *
 * Tidak mengubah: struktur data, query, kolom tabel, field form,
 * Resource, model, atau logic apa pun -- murni presentation layer.
 * ============================================================ */

:root {
    --toya-radius-sm: 0rem;
    --toya-radius-md: 0.3rem;
    --toya-radius-lg: 0.6rem;

    --toya-shadow-xs: 0 1px 2px rgba(24, 24, 27, 0.04);
    --toya-shadow-sm: 0 1px 3px rgba(24, 24, 27, 0.06), 0 1px 2px rgba(24, 24, 27, 0.04);
    --toya-shadow-md: 0 4px 12px rgba(24, 24, 27, 0.07), 0 1px 3px rgba(24, 24, 27, 0.05);
    --toya-shadow-lg: 0 12px 28px rgba(24, 24, 27, 0.10), 0 2px 6px rgba(24, 24, 27, 0.05);

    --toya-focus-ring: 0 0 0 3.5px rgba(249, 115, 22, 0.16);
    --toya-border-neutral: #e4e4e7;
    --toya-border-neutral-strong: #d4d4d8;
}

.dark {
    --toya-border-neutral: rgba(255, 255, 255, 0.09);
    --toya-border-neutral-strong: rgba(255, 255, 255, 0.14);
}

/* ------------------------------------------------------------
 * 1. TOMBOL (BUTTONS)
 * ------------------------------------------------------------ */
.fi-btn,
.fi-icon-btn {
    border-radius: var(--toya-radius-sm) !important;
    font-weight: 400 !important;
    transition: background-color .15s ease, border-color .15s ease,
                box-shadow .15s ease, transform .08s ease, color .15s ease !important;
}

.fi-btn {
    padding-inline: 0.9rem !important;
    padding-block: 0.5rem !important;
    font-size: 0.8125rem !important;
    letter-spacing: 0.005em !important;
}

/* Primary (oranye) -- shadow lembut + efek "terangkat" saat hover */
.fi-btn.fi-color-primary,
.fi-btn.fi-color-primary.fi-ac-btn-action {
    background: var(--toya-orange) !important;
    box-shadow: var(--toya-shadow-sm) !important;
    border: 1px solid transparent !important;
}

.fi-btn.fi-color-primary:hover {
    background: var(--toya-orange-dark) !important;
    box-shadow: var(--toya-shadow-md) !important;
    transform: translateY(-1px) !important;
}

.fi-btn.fi-color-primary:active {
    transform: translateY(0) !important;
    box-shadow: var(--toya-shadow-xs) !important;
}

/* Tombol putih/netral (default, bukan primary/danger) -- outline bersih */
.fi-btn.fi-color-gray,
.fi-btn.fi-color-white {
    background: #ffffff !important;
    border: 1px solid var(--toya-border-neutral-strong) !important;
    color: var(--toya-text-primary) !important;
    box-shadow: var(--toya-shadow-xs) !important;
}

.fi-btn.fi-color-gray:hover,
.fi-btn.fi-color-white:hover {
    background: #fafafa !important;
    border-color: #a1a1aa !important;
    box-shadow: var(--toya-shadow-sm) !important;
}

.dark .fi-btn.fi-color-gray,
.dark .fi-btn.fi-color-white {
    background: rgba(255, 255, 255, 0.04) !important;
    color: #f4f4f5 !important;
}

/* Danger -- tegas tapi tetap konsisten dengan sistem shadow */
.fi-btn.fi-color-danger {
    box-shadow: var(--toya-shadow-sm) !important;
}

.fi-btn.fi-color-danger:hover {
    box-shadow: var(--toya-shadow-md) !important;
    transform: translateY(-1px) !important;
}

/* Tombol outlined (style="outlined") -- dua garis tipis konsisten */
.fi-btn.fi-btn-outlined {
    border-width: 1.5px !important;
    background: transparent !important;
    box-shadow: none !important;
}

/* Fokus keyboard -- WAJIB ada untuk aksesibilitas & kesan profesional */
.fi-btn:focus-visible,
.fi-icon-btn:focus-visible,
.fi-link:focus-visible {
    outline: none !important;
    box-shadow: var(--toya-focus-ring) !important;
}

/* Icon button (aksi baris tabel, dsb) -- bentuk bulat rapi + hover halus */
.fi-icon-btn {
    border-radius: var(--toya-radius-sm) !important;
    transition: background-color .15s ease, transform .08s ease !important;
}

.fi-icon-btn:hover {
    transform: translateY(-1px) !important;
}

.fi-icon-btn:active {
    transform: translateY(0) !important;
}

/* Disabled -- jelas tidak bisa diklik */
.fi-btn:disabled,
.fi-btn.fi-disabled {
    opacity: 0.55 !important;
    box-shadow: none !important;
    transform: none !important;
    cursor: not-allowed !important;
}

/* ------------------------------------------------------------
 * 2. TABEL (TABLES)
 * ------------------------------------------------------------ */
.fi-ta-ctn {
    border-radius: var(--toya-radius-lg) !important;
    box-shadow: var(--toya-shadow-sm) !important;
    overflow: hidden !important;
}

/* Header kolom -- latar sedikit lebih gelap, huruf kecil rapi, tegas */
.fi-ta-header-cell {
    background: #f7f7f8 !important;
    font-size: 0.6875rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.045em !important;
    text-transform: uppercase !important;
    color: var(--toya-text-secondary) !important;
    padding-block: 0.7rem !important;
}

.dark .fi-ta-header-cell {
    background: rgba(255, 255, 255, 0.025) !important;
}

/* Baris -- transisi halus, hover jelas tanpa berlebihan */
.fi-ta-row {
    transition: background-color .1s ease !important;
}

.fi-ta-row:hover {
    background-color: rgba(249, 115, 22, 0.05) !important;
}

.fi-ta-row:nth-child(even):hover {
    background-color: rgba(249, 115, 22, 0.06) !important;
}

.fi-ta-cell {
    padding-block: 0.65rem !important;
}

/* Baris terpilih (checkbox) -- beri aksen kiri oranye supaya jelas */
.fi-ta-row:has(.fi-checkbox-input:checked) {
    background-color: rgba(249, 115, 22, 0.07) !important;
    box-shadow: inset 3px 0 0 var(--toya-orange) !important;
}

/* Badge status -- pill lembut dengan titik indikator, bukan warna solid rata */
.fi-badge {
    padding-inline: 0.6rem !important;
    padding-block: 0.25rem !important;
    font-size: 0.6875rem !important;
    font-weight: 700 !important;
    border: 1px solid transparent !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.35rem !important;
}

.fi-badge::before {
    content: "" !important;
    width: 0.375rem !important;
    height: 0.375rem !important;
    border-radius: 9999px !important;
    background: currentColor !important;
    flex-shrink: 0 !important;
}

.fi-badge.fi-color-success { background: var(--toya-success-soft) !important; color: #15803d !important; border-color: rgba(22,163,74,0.18) !important; }
.fi-badge.fi-color-warning { background: var(--toya-warning-soft) !important; color: #b45309 !important; border-color: rgba(217,119,6,0.18) !important; }
.fi-badge.fi-color-danger  { background: var(--toya-danger-soft)  !important; color: #b91c1c !important; border-color: rgba(220,38,38,0.18) !important; }
.fi-badge.fi-color-info    { background: var(--toya-info-soft)    !important; color: #1d4ed8 !important; border-color: rgba(37,99,235,0.18) !important; }
.fi-badge.fi-color-gray    { background: #f4f4f5 !important; color: #52525b !important; border-color: rgba(82,82,91,0.15) !important; }

/* Kolom aksi -- jarak antar icon button rapi */
.fi-ta-actions-cell .fi-ta-actions,
.fi-ta-record-actions {
    gap: 0.35rem !important;
}

/* Search & filter toolbar */
.fi-ta-search-field .fi-input-wrp {
    box-shadow: var(--toya-shadow-xs) !important;
}

.fi-ta-search-field .fi-input-wrp:focus-within {
    box-shadow: var(--toya-focus-ring) !important;
}

/* Pagination -- halaman aktif ditonjolkan oranye */
.fi-pagination-item[aria-current="page"],
.fi-pagination-item-label[aria-current="page"] {
    background: var(--toya-orange) !important;
    color: #ffffff !important;
    border-color: var(--toya-orange) !important;
    font-weight: 700 !important;
}

.fi-pagination-item:not([aria-current="page"]):hover {
    background: #f4f4f5 !important;
}

/* Empty state -- lebih rapi & tidak kosong-terlalu-polos */
.fi-ta-empty-state-icon {
    background: var(--toya-orange-soft) !important;
    color: var(--toya-orange) !important;
}



/* ============================================================
 * REDESAIN v5 -- MODAL FORM (Create/Edit) ala referensi
 * ============================================================
 * Target: modal Create/Edit terasa lebih lega & modern -- subtitle
 * di bawah judul, tombol close bulat dengan border, field lebih
 * tinggi dengan ikon di kiri (ikon di-set per field lewat
 * ->prefixIcon() di Resource, section ini cuma merapikan tampilannya),
 * footer tombol lebih rapi.
 * Tidak mengubah field/kolom/logic apa pun.
 * ============================================================ */

/* Modal lebih lega & sudut lebih membulat */
.fi-modal-window {
    border-radius: 1.1rem !important;
}

.fi-modal-header {
    align-items: flex-start !important;
    padding-block: 1.5rem !important;
}

.fi-modal-heading {
    font-size: 1.15rem !important;
    font-weight: 700 !important;
}

/* Subtitle (modalDescription) -- dipisah jarak dari judul, warna muted */
.fi-modal-heading-ctn .fi-modal-description,
.fi-modal-header-heading-ctn p {
    margin-block-start: 0.3rem !important;
    font-size: 0.8125rem !important;
    color: var(--toya-text-muted) !important;
}

/* Tombol close (X) -- bulat, border tipis, hover halus */
.fi-modal-close-btn {
    border-radius: 9999px !important;
    border: 1px solid var(--toya-border-neutral) !important;
    width: 2.15rem !important;
    height: 2.15rem !important;
    transition: background-color .15s ease, border-color .15s ease !important;
}

.fi-modal-close-btn:hover {
    background: #f4f4f5 !important;
    border-color: var(--toya-border-neutral-strong) !important;
}

/* Ikon prefix di dalam field -- abu netral, tidak menyaingi teks
 * (border/tinggi/shadow field sendiri sudah dibalikin ke default
 * Filament, ini cuma ngewarnain ikonnya saja). */
.fi-input-wrp-prefix-icon,
.fi-input-wrp .fi-icon {
    color: #a1a1aa !important;
}

.fi-input-wrp:focus-within .fi-input-wrp-prefix-icon {
    color: var(--toya-orange) !important;
}

/* Pembatas antar Group field di dalam form -- lebih lega, garis lebih halus */
.fi-fo-component-ctn > div[style*="border-block-start"] {
    border-color: #f4f4f5 !important;
}

/* Footer modal -- tombol rapi & rata kanan, jarak antar tombol lega */
.fi-modal-footer-actions {
    gap: 0.6rem !important;
}

/* Tombol "Cancel" & "Create & create another" (keduanya default
 * color=gray dari Filament) -- outline netral bersih, senada. Tombol
 * utama (submit, color=primary/oranye) TIDAK kena rule ini. */
.fi-modal-footer .fi-btn.fi-color-gray {
    background: #ffffff !important;
    color: var(--toya-text-primary) !important;
    border: 1px solid var(--toya-border-neutral-strong) !important;
    box-shadow: none !important;
}

.fi-modal-footer .fi-btn.fi-color-gray:hover {
    background: #fafafa !important;
}

/* Urutan DOM Filament: Create (submit/primary) -> Create & create
 * another (gray) -> Cancel (gray). Dibalik secara visual saja (DOM &
 * urutan tab tetap sama) supaya tombol utama oranye ada di kanan,
 * sesuai referensi: Cancel, Create & create another, Create. */
.fi-modal-footer-actions {
    display: flex !important;
    flex-direction: row-reverse !important;
    justify-content: flex-start !important;
    gap: 0.6rem !important;
}


/* ============================================================
 * REDESAIN v8 -- HAPUS HIGHLIGHT AUTOFILL BROWSER (BENERAN, kali ini)
 * ============================================================
 * Kotak oranye yang muncul di sekeliling field (Password, Select,
 * field bernilai default) BUKAN dari rule CSS kita -- itu box-shadow
 * inset bawaan Chrome/Edge untuk field yang di-autofill/di-highlight
 * browser, ditimpakan LANGSUNG ke elemen <input>/<select>, bukan ke
 * div pembungkusnya -- makanya styling di .fi-input-wrp saja tidak
 * cukup untuk menghapusnya. Section ini menembak elemen native-nya
 * langsung.
 * ============================================================ */

/* Chrome/Edge/Safari: box-shadow inset kuning/oranye pada field yang
 * ditandai untuk autofill. Ditimpa balik dengan box-shadow putih polos
 * + delay transisi supaya warnanya tidak sempat muncul sama sekali. */
input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active,
select:-webkit-autofill,
select:-webkit-autofill:hover,
select:-webkit-autofill:focus,
textarea:-webkit-autofill,
textarea:-webkit-autofill:hover,
textarea:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
    box-shadow: 0 0 0 1000px #ffffff inset !important;
    -webkit-text-fill-color: var(--toya-text-primary) !important;
    caret-color: var(--toya-text-primary) !important;
    transition: background-color 999999s ease-in-out 0s, color 999999s ease-in-out 0s !important;
    border-color: var(--toya-border-neutral) !important;
}

.dark input:-webkit-autofill,
.dark select:-webkit-autofill,
.dark textarea:-webkit-autofill {
    -webkit-box-shadow: 0 0 0 1000px #18181b inset !important;
    box-shadow: 0 0 0 1000px #18181b inset !important;
    -webkit-text-fill-color: #f4f4f5 !important;
}

/* Firefox punya mekanisme beda (tidak pakai box-shadow inset) --
 * ini jaga-jaga kalau browser lain memberi warna latar sendiri. */
input:autofill,
select:autofill,
textarea:autofill {
    background-color: #ffffff !important;
    border-color: var(--toya-border-neutral) !important;
}

/* Jaga-jaga tambahan: paksa border native <input>/<select> yang
 * dibungkus .fi-input-wrp SELALU transparan (border sebenarnya datang
 * dari div pembungkus .fi-input-wrp, bukan dari elemen ini) supaya
 * pseudo-class bawaan browser (:invalid/:required/:valid/:optional)
 * tidak pernah menggambar outline/border warna apa pun. */
.fi-input-wrp input,
.fi-input-wrp select,
.fi-input-wrp textarea {
    border-color: transparent !important;
    box-shadow: none !important;
    outline: none !important;
}

.fi-input-wrp input:invalid,
.fi-input-wrp input:required,
.fi-input-wrp input:valid,
.fi-input-wrp select:invalid,
.fi-input-wrp select:required {
    border-color: transparent !important;
    box-shadow: none !important;
}

/* Choices.js (dropdown Select Filament) -- elemen native <select>
 * yang disembunyikan tetap bisa kena autofill/invalid browser lalu
 * "menembus" ke wrapper visualnya lewat class is-focused. Dipaksa
 * netral juga, fokus asli tetap lewat :focus-within di section v4. */
.choices__inner.is-focused,
.choices[data-type]:has(select:invalid) .choices__inner,
.choices[data-type]:has(select:required) .choices__inner {
    border-color: var(--toya-border-neutral) !important;
    box-shadow: var(--toya-shadow-xs) !important;
}

/* ============================================================
 * REDESAIN v10 -- DROPDOWN (SELECT) KOTAK, TIDAK ABU-ABU
 * ============================================================
 * Text field biasa sudah pakai default Filament (polos, cuma border
 * tipis, tidak ada bg). Dropdown/select masih pakai default Filament
 * sendiri yang beda: sudut membulat + latar abu-abu. Disamakan di
 * sini SAJA (radius kotak + latar putih) tanpa menambah shadow/ring
 * custom lain, biar tetap konsisten "default look" tapi kotak.
 * ============================================================ */
.fi-select-input,
.choices__inner,
.choices__list--dropdown,
.choices__list[aria-expanded] {
    border-radius: 0 !important;
    background-color: #ffffff !important;
}

.dark .fi-select-input,
.dark .choices__inner,
.dark .choices__list--dropdown {
    background-color: transparent !important;
}


/* ============================================================
 * REDESAIN v11 -- KOTAK IKON PREFIX DIHAPUS, OUTLINE TIPIS KOTAK
 * ============================================================
 * Default Filament: wrapper field pakai shadow+ring (bukan border
 * literal) untuk garis pinggirnya, dan kotak ikon prefix (Username=
 * orang, Password=gembok, dst) punya garis pemisah + nuansa abu.
 * Diganti jadi: ikon polos tanpa kotak/bg sama sekali, dan field
 * pakai border tipis literal warna netral, sudut kotak (radius 0).
 * ============================================================ */

/* Wrapper field -- border tipis literal, kotak, tanpa shadow/ring
 * bawaan Filament (biar tidak dobel sama border yang kita tambah). */
.fi-input-wrp {
    border: 1px solid var(--toya-border-neutral) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
}

.dark .fi-input-wrp {
    background-color: transparent !important;
}

/* Kotak ikon prefix/suffix (Username, Password, Rp, dst) -- hilangkan
 * latar & garis pemisahnya, biarkan ikon menyatu polos dengan field. */
.fi-input-wrp-prefix,
.fi-input-wrp-suffix {
    background-color: transparent !important;
    border-color: transparent !important;
}

/* Dropdown (select/choices.js) -- border tipis kotak yang sama,
 * karena section v10 sebelumnya cuma hapus radius+bg, belum kasih
 * border literal. */
.choices__inner {
    border: 1px solid var(--toya-border-neutral) !important;
    box-shadow: none !important;
}

/* ============================================================
 * REDESAIN v12 -- GARIS FIELD LEBIH SAMAR + SEMUA IKON TANPA BG ABU
 * ============================================================
 * Berlaku ke SEMUA halaman termasuk halaman Login (satu file
 * theme.css yang sama dipakai di sana juga). Ditulis dengan
 * spesifisitas tinggi di paling akhir file supaya pasti menang dari
 * rule versi manapun sebelumnya.
 * ============================================================ */

/* Border field jadi jauh lebih samar (bukan abu tegas, apalagi
 * oranye terang) -- garis cuma "penanda area", bukan elemen visual
 * yang menonjol. */
.fi-body .fi-input-wrp,
.fi-simple-layout .fi-input-wrp {
    border: 1px solid rgba(0, 0, 0, 0.09) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
}

.dark .fi-body .fi-input-wrp,
.dark .fi-simple-layout .fi-input-wrp {
    border-color: rgba(255, 255, 255, 0.12) !important;
}

.fi-body .choices__inner,
.fi-simple-layout .choices__inner {
    border: 1px solid rgba(0, 0, 0, 0.09) !important;
    box-shadow: none !important;
}

/* SEMUA tombol ikon (termasuk ikon mata show/hide password di field
 * Login) -- tidak ada latar abu/kotak di belakangnya, di halaman
 * mana pun. */
.fi-icon-btn,
.fi-input-wrp-actions .fi-icon-btn,
.fi-input-wrp-suffix .fi-icon-btn,
.fi-input-wrp-prefix .fi-icon-btn {
    background-color: transparent !important;
    box-shadow: none !important;
}

.fi-input-wrp-prefix,
.fi-input-wrp-suffix,
.fi-input-wrp-actions {
    background-color: transparent !important;
    border-color: transparent !important;
}

/* ============================================================
 * PENUTUP FINAL #23: SEMUA TOMBOL SERAGAM (oranye + ukuran sama)
 * ============================================================
 * Permintaan terbaru: semua tombol (bukan cuma yang "primary") jadi
 * warna oranye seragam, dan ukurannya disamakan (tinggi & padding),
 * supaya tidak ada yang kelihatan lebih besar/kecil sebelah. Di HP,
 * tombol jadi full-width dan disusun ke bawah (bukan berdempetan
 * menyamping yang bikin berantakan).
 *
 * Dikecualikan: tombol ikon-saja di kolom Aksi tabel (.fi-ta-actions,
 * td .fi-icon-btn) — itu sudah diatur size/warna beda di bagian lain
 * file ini (per jenis aksi), sengaja tidak disamaratakan supaya tetap
 * bisa dibedakan Edit/Hapus/dll dari warnanya.
 */
.fi-btn:not(.fi-ta-actions .fi-btn) {
    background-color: var(--toya-orange, #f97316) !important;
    border-color: var(--toya-orange, #f97316) !important;
    color: #ffffff !important;
    min-height: 2.4rem !important;
    height: 2.4rem !important;
    padding-inline: 1rem !important;
    font-size: 0.8125rem !important;
    font-weight: 600 !important;
    box-shadow: none !important;
}

.fi-btn:not(.fi-ta-actions .fi-btn) * {
    color: #ffffff !important;
}

.fi-btn:not(.fi-ta-actions .fi-btn):hover {
    background-color: var(--toya-orange-dark, #ea580c) !important;
    border-color: var(--toya-orange-dark, #ea580c) !important;
}

/* HP/tablet: tombol header/toolbar (Tambah, Aksi, Export, dst) jadi
 * full-width, disusun vertikal ke bawah — bukan berdempetan menyamping
 * yang bikin terlihat berantakan/terpotong. */
@media (max-width: 767px) {
    .fi-ta-header-ctn,
    .fi-header-actions-ctn {
        flex-direction: column !important;
        align-items: stretch !important;
    }

    .fi-ta-header,
    .fi-ta-header-toolbar,
    .fi-header-actions-ctn .fi-ac-actions {
        flex-direction: column !important;
        align-items: stretch !important;
        width: 100% !important;
    }

    .fi-ta-header .fi-btn,
    .fi-ta-header-toolbar .fi-btn,
    .fi-header-actions-ctn .fi-btn {
        width: 100% !important;
        justify-content: center !important;
    }

    /* Search field ikut selebar layar juga, supaya sejajar rapi dengan
     * tombol-tombol di atas/bawahnya. */
    .fi-ta-search-field {
        max-width: 100% !important;
        width: 100% !important;
    }
}

