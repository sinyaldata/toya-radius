/* ===== MODE IKON (sidebar collapsed)   ikon rata tengah & flyout jalan =====
 * Semua aturan di bawah HANYA berlaku saat sidebar TIDAK punya class
 * "fi-sidebar-open" (= sedang collapsed jadi rail ikon).
 */
@media (min-width: 1024px) {
    /* Kontainer nav: padding kiri-kanan dikecilkan supaya ikon benar-benar
     * bisa duduk di tengah rail sempit. */
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-nav-groups {
        padding-inline: 0.35rem !important;
    }

    /* Tombol item & tombol dropdown grup: isi dibuat rata tengah, padding
     * kiri (yang tadinya untuk teks + bullet) dinolkan. */
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-item-btn,
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-group-dropdown-trigger-btn {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding-inline: 0 !important;
        gap: 0 !important;
        width: 100% !important;
    }

    /* Bullet oranye sub-menu & teks label: tidak relevan di mode ikon. */
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-item-btn::before {
        display: none !important;
    }

    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-item-label,
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-group-label {
        display: none !important;
    }

    /* Ukuran ikon diseragamkan supaya kolomnya lurus rapi. */
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-item-btn svg,
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-group-dropdown-trigger-btn svg {
        width: 1.35rem !important;
        height: 1.35rem !important;
        flex-shrink: 0 !important;
    }

    /* Tombol/pill kosong tanpa ikon (sisa item yang ikonnya sengaja
     * dikosongkan)   sembunyikan supaya tidak jadi "blob" abu-abu. */
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-item-btn:not(:has(svg)) {
        display: none !important;
    }

    /* Jarak antar ikon dirapikan sedikit. */
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-group,
    body:has(.fi-sidebar:not(.fi-sidebar-open)) .fi-sidebar-item {
        margin-block: 0.1rem !important;
    }

    /* Flyout sub-menu saat hover: pastikan tampil di atas elemen lain dan
     * tidak ikut terpotong. */
    .fi-sidebar .fi-dropdown-panel,
    .fi-sidebar-group-dropdown-trigger-btn + .fi-dropdown-panel {
        z-index: 50 !important;
    }
}

/* Saat mode ikon, .fi-sidebar-nav TIDAK boleh scroll   overflow-y:auto di
