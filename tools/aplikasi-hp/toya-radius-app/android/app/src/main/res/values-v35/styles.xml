<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15: tetap tampilan klasik (bilah status berwarna, isi tidak tertutup) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/toya_oranye</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/toya_putih</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/toya_putih</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
