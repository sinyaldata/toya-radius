/* =====================================================================
 * Footer & Topbar tetap di tempat saat discroll (permintaan user
 * 2026-09-18).
 *
 * TOPBAR: Filament sendiri SUDAH memberi "sticky top-0" secara bawaan
 * (vendor/filament/filament/resources/css/components/topbar.css) --
 * aturan di bawah cuma PENEGASAN (pakai !important) supaya dijamin
 * menang, jaga-jaga ada aturan lain di file ini yang tidak sengaja
 * menimpanya.
 *
 * FOOTER (.tya-footer, kartu "Sistem Aman / Database / Versi Sistem"):
 * ini murni buatan sendiri (bukan bawaan Filament), SEBELUMNYA belum
 * diberi posisi apa pun -- jadi ikut scroll biasa bareng isi halaman.
 * Ditambah sticky ke bawah di sini.
 * ===================================================================== */

.fi-topbar {
    position: sticky !important;
    top: 0 !important;
    z-index: 30 !important;
}

.tya-footer {
    position: sticky !important;
    bottom: 0 !important;
    z-index: 20 !important;
    /* PENTING: aturan lama footer ini "background: transparent" --
       kalau dibiarkan transparan sambil sticky, konten yang discroll
       bakal keliatan numpuk/tembus di belakang tulisannya. Diberi
       warna solid di sini supaya benar-benar terlihat sebagai bar
       yang menempel, bukan tembus pandang. */
    background: #ffffff !important;
    border-top: 1px solid rgb(228 228 231) !important;
}
.dark .tya-footer {
    background: #18181b !important;
    border-top-color: rgba(255, 255, 255, 0.08) !important;
}
