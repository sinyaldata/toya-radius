    color: #18181b !important;
    font-size: 1rem !important;
    font-weight: 750 !important;
    letter-spacing: -.01em !important;
}

/* Description/subheading */
.fi-modal-header .fi-modal-description {
    color: #71717a !important;
    font-size: .74rem !important;
    margin-top: .2rem !important;
}

/* Close button */
.fi-modal-header .fi-icon-btn,
.fi-modal-header button {
    width: 2.2rem !important;
    height: 2.2rem !important;
    border-radius: .65rem !important;
    color: #52525b !important;
    border: 1px solid #e4e4e7 !important;
    background: #fff !important;
}

.fi-modal-header .fi-icon-btn:hover,
.fi-modal-header button:hover {
    background: #fafafa !important;
    color: #18181b !important;
}

/* Modal body -- INI area yang benar-benar boleh scroll sekarang.
 * flex:1 supaya mengisi sisa ruang antara header & footer yang sudah
 * dipatok flex-shrink:0, dan min-height:0 WAJIB ada -- tanpa ini flex
 * child menolak menyusut di bawah tinggi kontennya sendiri, jadi
 * overflow-y:auto di bawah tidak akan pernah benar-benar aktif untuk
 * konten yang sangat tinggi (contoh: repeater banyak baris di form
 * Biller) walau kelihatan seperti sudah "auto". */
.fi-modal-content {
    padding: 1.15rem 1.35rem 1.3rem !important;
    background: #fff !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
    overflow-x: clip !important;
    -webkit-overflow-scrolling: touch !important;
}

